<UserControl x:Class="SafeCheck.Controls.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Width="40" Height="40">
    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <RotateTransform x:Name="SpinTransform" CenterX="20" CenterY="20"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinStoryboard}"/>
        </EventTrigger>
    </UserControl.Triggers>
    <Viewbox>
        <Canvas Width="40" Height="40">
            <Path Data="M20,4 A16,16 0 1 1 4,20" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
    </Viewbox>
</UserControl>
