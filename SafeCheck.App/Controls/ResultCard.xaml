<UserControl x:Class="SafeCheck.Controls.ResultCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SafeCheck.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <conv:RiskLevelToColorConverter x:Key="RiskToColor"/>
        <conv:RiskLevelToTextConverter x:Key="RiskToText"/>
        <conv:RiskLevelToEmojiConverter x:Key="RiskToEmoji"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ObjectToBoolConverter x:Key="NotNull"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,12,0,0"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel>
            <Border Background="{Binding Result.Risk, ElementName=Root, Converter={StaticResource RiskToColor}}"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Result.Risk, ElementName=Root, Converter={StaticResource RiskToEmoji}}"
                               FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Result.Risk, ElementName=Root, Converter={StaticResource RiskToText}}"
                               FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="Risk: "/>
                        <Run Text="{Binding Result.RiskPercent, ElementName=Root, Mode=OneWay}"/>
                        <Run Text="%"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Result.Input, ElementName=Root}" FontSize="14"
                       Foreground="#666" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <TextBlock Text="FINDINGS" FontSize="12" FontWeight="SemiBold"
                       Foreground="#999" Margin="0,4,0,4"/>
            <ItemsControl ItemsSource="{Binding Result.Findings, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="14" Margin="0,2" TextWrapping="Wrap">
                            <Run Text="  " /><Run Text="{Binding Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="WHAT TO DO" FontSize="12" FontWeight="SemiBold"
                       Foreground="#999" Margin="0,12,0,4"/>
            <ItemsControl ItemsSource="{Binding Result.Recommendations, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,2" TextWrapping="Wrap">
                            <Run Text="{Binding Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Result.Summary, ElementName=Root}" FontSize="12"
                       Foreground="#999" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <Button Content="Search Google for more info" Margin="0,12,0,0"
                    Click="SearchGoogle_Click" HorizontalAlignment="Stretch"
                    FontSize="14" Padding="12,10" Cursor="Hand"
                    Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result.GoogleSearchUrl, ElementName=Root, Converter={StaticResource NotNull}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <ItemsControl ItemsSource="{Binding Result.LookupLinks, ElementName=Root}"
                          Margin="0,4,0,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result.HasLookupLinks, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Margin="0,4,0,0"
                                Tag="{Binding Url}" Click="LookupLink_Click"
                                HorizontalAlignment="Stretch"
                                FontSize="13" Padding="10,8" Cursor="Hand"
                                Background="#E8F0FE" BorderBrush="#B0C4DE" BorderThickness="1"
                                Foreground="#0078D4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
