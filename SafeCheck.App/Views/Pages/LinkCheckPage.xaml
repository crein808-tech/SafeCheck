<Page x:Class="SafeCheck.Views.Pages.LinkCheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SafeCheck.ViewModels"
      xmlns:ctrl="clr-namespace:SafeCheck.Controls"
      Background="{StaticResource BgBrush}">
    <Page.DataContext>
        <vm:LinkCheckVM/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="440" HorizontalAlignment="Center">
            <Button Content="Back to Home" Style="{StaticResource BackButton}"
                    Click="Back_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Text="Check Link" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <TextBlock Text="Paste the website link you want to check" FontSize="14"
                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource InputBox}" x:Name="InputBox"
                         Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                         Loaded="Input_Loaded" KeyDown="Input_KeyDown"/>
                <Button Grid.Column="1" Content="Paste" Click="Paste_Click"
                        Margin="4,0,0,0" Padding="8,6" VerticalAlignment="Center" Cursor="Hand"/>
            </Grid>

            <Button Content="CHECK LINK" Style="{StaticResource ActionButton}"
                    Command="{Binding ScanCommand}" Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"/>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ctrl:LoadingSpinner/>
                <TextBlock Text="Checking..." FontSize="14" Foreground="{StaticResource SubtleBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <ctrl:ResultCard Result="{Binding Result}">
                <ctrl:ResultCard.Style>
                    <Style TargetType="ctrl:ResultCard">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result, Converter={StaticResource NotNull}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctrl:ResultCard.Style>
            </ctrl:ResultCard>
        </StackPanel>
    </ScrollViewer>
</Page>
