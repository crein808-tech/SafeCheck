<Page x:Class="SafeCheck.Views.Pages.FileCheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SafeCheck.ViewModels"
      xmlns:ctrl="clr-namespace:SafeCheck.Controls"
      Background="{StaticResource BgBrush}">
    <Page.DataContext>
        <vm:FileCheckVM/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="440" HorizontalAlignment="Center">
            <Button Content="Back to Home" Style="{StaticResource BackButton}"
                    Click="Back_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Text="Check File" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
            <TextBlock Text="Choose a file to scan for viruses" FontSize="14"
                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,16"/>

            <Button Content="CHOOSE FILE" Style="{StaticResource ActionButton}"
                    Click="ChooseFile_Click" HorizontalAlignment="Stretch"/>

            <TextBox Style="{StaticResource InputBox}" Margin="0,8,0,0"
                     Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True" Background="#F0F0F0"/>

            <Button Content="SCAN FILE" Style="{StaticResource ActionButton}"
                    Command="{Binding ScanCommand}" Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"/>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ctrl:LoadingSpinner/>
                <TextBlock Text="{Binding StatusText}" FontSize="14"
                           Foreground="{StaticResource SubtleBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <ctrl:ResultCard Result="{Binding Result}">
                <ctrl:ResultCard.Style>
                    <Style TargetType="ctrl:ResultCard">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result, Converter={StaticResource NotNull}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctrl:ResultCard.Style>
            </ctrl:ResultCard>
        </StackPanel>
    </ScrollViewer>
</Page>
