<Page x:Class="SafeCheck.Views.Pages.AskAIPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SafeCheck.ViewModels"
      Background="{StaticResource BgBrush}">
    <Page.DataContext>
        <vm:AskAIVM/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Content="Back to Home" Style="{StaticResource BackButton}"
                Click="Back_Click" HorizontalAlignment="Left" Margin="24,12,0,0"/>

        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <TextBlock Text="Ask AI" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Ask general safety questions — for checking a specific phone number, email, or link, use the dedicated tools on the home screen"
                       FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0"
                      x:Name="ChatScroll">
            <ItemsControl ItemsSource="{Binding Messages}" x:Name="ChatList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="12,10" CornerRadius="10" MaxWidth="380">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="Background" Value="#DCF8C6"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource InputBox}"
                     Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="Input_KeyDown" x:Name="QuestionBox"/>
            <Button Grid.Column="1" Content="ASK" Style="{StaticResource ActionButton}"
                    Command="{Binding AskCommand}" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Page>
