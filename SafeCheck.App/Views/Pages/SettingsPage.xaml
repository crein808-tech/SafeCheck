<Page x:Class="SafeCheck.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:SafeCheck.ViewModels"
      Background="{StaticResource BgBrush}">
    <Page.DataContext>
        <vm:SettingsVM/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="440" HorizontalAlignment="Center">
            <Button Content="Back to Home" Style="{StaticResource BackButton}"
                    Click="Back_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,8,0,16"/>

            <TextBlock Text="API Keys" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="These keys are stored securely on your computer."
                       FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="VirusTotal API Key (for file and link scanning)" FontSize="13"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="VtKeyBox" FontSize="14" Padding="10,8"
                         PasswordChanged="VtKey_Changed"/>
            <TextBlock FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,2,0,12">
                <Run Text="Free key from virustotal.com — 500 scans/day"/>
            </TextBlock>

            <TextBlock Text="Google Gemini API Key (for AI assistant)" FontSize="13"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="GeminiKeyBox" FontSize="14" Padding="10,8"
                         PasswordChanged="GeminiKey_Changed"/>
            <TextBlock FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,2,0,12">
                <Run Text="Free key from aistudio.google.com — 1,000 questions/day"/>
            </TextBlock>

            <TextBlock Text="Groq API Key (backup AI assistant)" FontSize="13"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="GroqKeyBox" FontSize="14" Padding="10,8"
                         PasswordChanged="GroqKey_Changed"/>
            <TextBlock FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,2,0,12">
                <Run Text="Free key from console.groq.com — used if Gemini is unavailable"/>
            </TextBlock>

            <TextBlock Text="CheckPhish API Key (phishing detection for links)" FontSize="13"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="CheckPhishKeyBox" FontSize="14" Padding="10,8"
                         PasswordChanged="CheckPhishKey_Changed"/>
            <TextBlock FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,2,0,12">
                <Run Text="Free key from checkphish.bolster.ai — 25 scans/day, used as fallback for link checks"/>
            </TextBlock>

            <Button Content="SAVE SETTINGS" Style="{StaticResource ActionButton}"
                    Command="{Binding SaveCommand}" HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"/>

            <TextBlock Text="{Binding StatusText}" FontSize="14"
                       Foreground="{StaticResource SafeBrush}" HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,20,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="About SafeCheck" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666" Margin="0,6,0,0"
                               Text="SafeCheck helps you check suspicious emails, phone calls, files, and links. It uses free online services to give you a second opinion. Results are not 100% accurate — when in doubt, ask a family member or friend who knows about computers."/>
                    <TextBlock Text="Version 1.0.0" FontSize="11" Foreground="#999" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
